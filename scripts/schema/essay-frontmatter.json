{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Essay front matter",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "title",
    "topic",
    "author",
    "status",
    "started_at",
    "deadline_at",
    "initial_status",
    "version",
    "word_range"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "coauthors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "acknowledgments": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": ["user"],
            "properties": {
              "user": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              },
              "since_version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "string",
            "minLength": 1
          }
        ]
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published"]
    },
    "started_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
    },
    "deadline_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
    },
    "initial_status": {
      "type": "string",
      "enum": ["complete", "unfinished"]
    },
    "version": {
      "type": "number",
      "minimum": 0
    },
    "published_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
    },
    "word_range": {
      "type": "string",
      "pattern": "^\\d{2,4}-\\d{2,4}$"
    },
    "release_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "published" }
        }
      },
      "then": {
        "required": ["published_at"]
      }
    }
  ]
}
