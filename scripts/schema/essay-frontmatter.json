{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Essay front matter",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "title",
    "topic",
    "author",
    "status",
    "started_at",
    "deadline_at",
    "initial_status",
    "version",
    "word_range"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "maxItems": 5,
      "default": []
    },
    "coauthors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "acknowledgments": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": ["user"],
            "properties": {
              "user": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              },
              "since_version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "string",
            "minLength": 1
          }
        ]
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "draft", "published"]
    },
    "started_at": {
      "anyOf": [
        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$" },
        { "type": "object" }
      ]
    },
    "proposed_at": {
      "anyOf": [
        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$" },
        { "type": "object" }
      ]
    },
    "deadline_at": {
      "anyOf": [
        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$" },
        { "type": "object" }
      ]
    },
    "deadline_at_time": {
      "type": "string",
      "pattern": "^\\d{2}:\\d{2}(?::\\d{2})?(?:Z|[+-]\\d{2}:?\\d{2})?$"
    },
    "initial_status": {
      "type": "string",
      "enum": ["complete", "unfinished"]
    },
    "version": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
        },
        {
          "type": "number",
          "minimum": 0
        }
      ]
    },
    "published_at": {
      "anyOf": [
        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$" },
        { "type": "object" }
      ]
    },
    "word_range": {
      "type": "string",
      "enum": ["250-500", "500-1000", "1000-1500"]
    },
    "release_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "canonical_url": {
      "type": "string",
      "minLength": 1
    },
    "word_count": {
      "type": "number",
      "minimum": 0
    },
    "social_image": {
      "type": "string",
      "minLength": 1
    },
    "permalink": {
      "type": ["string", "boolean"],
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "published" }
        }
      },
      "then": {
        "required": ["published_at"]
      }
    }
  ]
}
