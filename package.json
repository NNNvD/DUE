{
  "name": "due-starter-eleventy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/buildSite.js",
    "start": "eleventy --serve",
    "serve:built": "node scripts/serveBuiltSite.js",
    "check:frontmatter": "node scripts/validateFrontmatter.js",
    "check:words": "node scripts/checkWordRange.js",
    "check:a11y": "node scripts/checkA11y.js",
    "autopublish": "node scripts/autopublish.js",
    "new": "node scripts/newDraft.js",
    "bump": "node scripts/bumpVersionAndCredit.js",
    "test": "vitest",
    "test:e2e": "npm run build && playwright test",
    "lint:md": "node scripts/lintMarkdown.js",
    "validate:feeds": "node scripts/validateFeeds.js",
    "verify:feeds": "npm run build && npm run validate:feeds",
    "verify:comments-live": "node scripts/verifyCommentIntakeLive.js",
    "promote:comments": "node scripts/promoteComments.js",
    "qa": "npm run check:words && npm run build && npm run check:a11y && npm run validate:feeds"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@playwright/test": "^1.59.1",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "dayjs": "^1.11.13",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.2.0",
    "glob": "^11.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "remark-parse": "^11.0.0",
    "strip-markdown": "^6.0.0",
    "unified": "^11.0.5"
  }
}
