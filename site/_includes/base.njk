
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set metaTitle = ogTitle or title or site.title %}
  {% set canonicalUrl = canonical or meta.buildCanonicalUrl({ page: page, site: site }) %}
  <title>{{ metaTitle }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {% if canonicalUrl %}
  <link rel="canonical" href="{{ canonicalUrl }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  {% endif %}
  {% if description %}
  <meta name="description" content="{{ description }}">
  <meta property="og:description" content="{{ description }}">
  {% endif %}
  <meta property="og:title" content="{{ metaTitle }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }} feed" href="{{ '/feeds/feed.xml' | url | absoluteUrl(site) }}">
  <link rel="alternate" type="application/feed+json" title="{{ site.title }} feed (JSON)" href="{{ '/feeds/feed.json' | url | absoluteUrl(site) }}">
  {% if socialImage %}
  <meta property="og:image" content="{{ socialImage }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ socialImage }}">
  {% else %}
  <meta name="twitter:card" content="summary">
  {% endif %}
  <meta name="twitter:title" content="{{ metaTitle }}">
  {% if description %}
  <meta name="twitter:description" content="{{ description }}">
  {% endif %}
  {% if jsonLd %}
  <script type="application/ld+json">
    {{ jsonLd | dump | safe }}
  </script>
  {% endif %}
  <link rel="stylesheet" href="{{ "/assets/style.css" | url }}">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <div class="page-shell">
    <header class="site-header">
      <div class="brand">
        <h1><a href="{{ "/" | url }}">{{ site.title }}</a></h1>
        <small>{{ site.tagline }}</small>
      </div>
      {% set navLinks = [
        { href: '/', label: 'Home' },
        { href: '/essays/', label: 'Essays' },
        { href: '/about/', label: 'About' },
        { href: '/contribute/', label: 'Contribute', pill: true }
      ] %}
      <nav aria-label="Primary navigation">
        {% for link in navLinks %}
          <a{% if link.pill %} class="pill pill--outline"{% endif %} href="{{ link.href | url }}">{{ link.label }}</a>
        {% endfor %}
      </nav>
    </header>
    <main id="main-content">
      {% set breadcrumbEnabled = breadcrumb is not defined or breadcrumb %}
      {% set pathStem = page.filePathStem or '' %}
      {% set stemParts = pathStem | split('/') %}
      {% set lastSegment = '' %}
      {% for part in stemParts %}
        {% if part and part != 'index' and part != 'published' and part != 'drafts' %}
          {% set lastSegment = part %}
        {% endif %}
      {% endfor %}
      {% set hasBreadcrumbs = lastSegment != '' %}
      {% if breadcrumbEnabled and hasBreadcrumbs %}
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="{{ "/" | url }}">Home</a></li>
            {% set accumulated = '' %}
            {% for part in stemParts %}
              {% if part and part != 'index' %}
                {% set accumulated = accumulated + '/' + part %}
                {% set isSkippable = part == 'published' or part == 'drafts' %}
                {% set label = part | replace('-', ' ') | replace('_', ' ') | capitalize %}
                {% if not isSkippable %}
                  {% if part != lastSegment %}
                    <li><a href="{{ (accumulated + '/') | url }}">{{ label }}</a></li>
                  {% else %}
                    <li aria-current="page">{{ label }}</li>
                  {% endif %}
                {% endif %}
              {% endif %}
            {% endfor %}
          </ol>
        </nav>
      {% endif %}
      {{ content | safe }}
    </main>
    <footer>
      Built with Eleventy · Content &copy; 2024–present Noah van Dongen & contributors. Subscribe via
      <a href="{{ '/feeds/feed.xml' | url }}">Atom</a>
      or
      <a href="{{ '/feeds/feed.json' | url }}">JSON</a> feeds.
    </footer>
  </div>
  <script type="module" src="{{ "/assets/countdown.js" | url }}"></script>
  <script type="module" src="{{ "/assets/comments.js" | url }}"></script>
  <script type="module" src="{{ "/assets/share.js" | url }}"></script>
</body>
</html>
