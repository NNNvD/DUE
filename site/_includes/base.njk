
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set metaTitle = ogTitle or title or site.title %}
  <title>{{ metaTitle }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {% if canonical %}
  <link rel="canonical" href="{{ canonical }}">
  <meta property="og:url" content="{{ canonical }}">
  {% endif %}
  {% if description %}
  <meta name="description" content="{{ description }}">
  <meta property="og:description" content="{{ description }}">
  {% endif %}
  <meta property="og:title" content="{{ metaTitle }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  {% if socialImage %}
  <meta property="og:image" content="{{ socialImage }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ socialImage }}">
  {% else %}
  <meta name="twitter:card" content="summary">
  {% endif %}
  <meta name="twitter:title" content="{{ metaTitle }}">
  {% if description %}
  <meta name="twitter:description" content="{{ description }}">
  {% endif %}
  <link rel="stylesheet" href="{{ site.baseUrl }}assets/style.css">
</head>
<body>
  <main>
    <header>
      <div class="brand">
        <h1><a href="{{ "/" | url }}">{{ site.title }}</a></h1>
        <small>{{ site.tagline }}</small>
      </div>
      <nav>
        <a href="{{ site.baseUrl }}">Home</a>
        <a href="{{ '/essays/' | url }}">Essays</a>
        <a href="{{ '/drafts/' | url }}">Drafts</a>
        <a href="{{ '/about/' | url }}">About</a>
        <a class="pill pill--outline" href="{{ site.baseUrl }}contribute/">Contribute</a>
      </nav>
    </header>
    {% set breadcrumbEnabled = breadcrumb is not defined or breadcrumb %}
    {% set pathStem = page.filePathStem or '' %}
    {% set stemParts = pathStem | split('/') %}
    {% set lastSegment = '' %}
    {% for part in stemParts %}
      {% if part and part != 'index' %}
        {% set lastSegment = part %}
      {% endif %}
    {% endfor %}
    {% set hasBreadcrumbs = lastSegment != '' %}
    {% if breadcrumbEnabled and hasBreadcrumbs %}
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="{{ site.baseUrl }}">Home</a></li>
          {% set accumulated = '' %}
          {% for part in stemParts %}
            {% if part and part != 'index' %}
              {% set accumulated = accumulated + '/' + part %}
              {% set label = part | replace('-', ' ') | replace('_', ' ') | capitalize %}
              {% if part != lastSegment %}
                <li><a href="{{ (accumulated + '/') | url }}">{{ label }}</a></li>
              {% else %}
                <li aria-current="page">{{ label }}</li>
              {% endif %}
            {% endif %}
          {% endfor %}
        </ol>
      </nav>
    {% endif %}
    {{ content | safe }}
    <footer>
      Built with Eleventy. Content &copy; {{ site.currentYear }}.
    </footer>
  </main>
  <script type="module" src="{{ "/assets/countdown.js" | url }}"></script>
</body>
</html>
