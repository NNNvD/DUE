
---
layout: base.njk
---
<article class="card">
  {% set meta = {
    version: version,
    initial_status: initial_status,
    word_range: word_range,
    published_at: published_at,
    author: author,
    coauthors: coauthors,
    acknowledgments: acknowledgments
  } | essayMeta %}
  <header class="essay-header">
    <h1 class="essay-title">{{ title }}</h1>
    <div class="essay-header__row">
      {% if meta.badges.length %}
        <div class="essay-badges" aria-label="Publication details">
          {% for badge in meta.badges %}
            <span class="badge badge--tone-{{ badge.tone }} badge--{{ badge.key }}"{% if badge.tooltip %} title="{{ badge.tooltip }}"{% endif %}>{{ badge.label }}</span>
          {% endfor %}
        </div>
      {% endif %}
      {% if meta.author or meta.coauthors.length or meta.acknowledgments.length %}
        <div class="essay-contributors" aria-label="Contributors">
          {% if meta.author %}
            <span class="badge badge--tone-{{ meta.author.tone }} badge--author" title="{{ meta.author.tooltip }}">@{{ meta.author.handle }}</span>
          {% endif %}
          {% for person in meta.coauthors %}
            <span class="badge badge--tone-{{ person.tone }} badge--coauthor"{% if person.tooltip %} title="{{ person.tooltip }}"{% endif %}>@{{ person.handle }}</span>
          {% endfor %}
          {% for ack in meta.acknowledgments %}
            <span class="badge badge--tone-{{ ack.tone }} badge--ack"{% if ack.tooltip %} title="{{ ack.tooltip }}"{% endif %}>@{{ ack.handle }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </header>
  <div class="content">
    {{ content | safe }}
  </div>
</article>

{% if page.inputPath and "essays/published/" in page.inputPath %}
  {% set ctaRelativePath = page.inputPath | replace("./", "") %}
  {% set ctaIssueTitle = ("Suggest change: " ~ ctaRelativePath) | urlencode %}
  {% set ctaIssueUrl = site.repoUrl ~ "/issues/new?template=suggest-change.yml&title=" ~ ctaIssueTitle %}
  {% include "cta-suggest-change.njk" %}
{% endif %}

<section class="card">
  <h3>Release notes</h3>
  {% if release_notes and release_notes.length %}
    <ul>
      {% for note in release_notes %}
        <li>{{ note }}</li>
      {% endfor %}
    </ul>
  {% else %}
    <p>No release notes yet.</p>
  {% endif %}
</section>

<section class="card">
  <h3>Acknowledgments</h3>
  {% if meta.acknowledgments and meta.acknowledgments.length %}
    <ul>
      {% for ack in meta.acknowledgments %}
        <li>
          @{{ ack.handle }}
          {% if ack.note %}— {{ ack.note }}{% endif %}
          {% if ack.since_version %}<span class="ack-since">(since v{{ ack.since_version }})</span>{% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>Contribute a minor improvement (grammar, phrasing, examples, references) to be credited here.</p>
  {% endif %}
</section>


<section class="card">
  <h3>Version history</h3>
  {% set currentSlug = page.fileSlug %}
  {% set snapshots = collections.snapshots | snapshotsForSlug(currentSlug) %}
  {% set hasSnapshots = snapshots | length %}
  {% if hasSnapshots %}
    <ul class="history-list">
      {% for snap in snapshots %}
        {% set note = null %}
        {% if snap.data.release_notes and snap.data.release_notes.length %}
          {% set note = snap.data.release_notes[0] %}
        {% endif %}
        {% set historyDate = snap.data.published_at or null %}
        <li>
          <div class="history-line">
            <a class="history-version" href="{{ snap.url | url }}">v{{ snap.data.version }}</a>
            {% if historyDate %}
              <span class="history-date">{{ historyDate | date("yyyy-LL-dd") }}</span>
            {% endif %}
          </div>
          {% if note %}
            <p class="history-note">{{ note }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>No snapshots yet.</p>
  {% endif %}
  {% if currentSlug and currentSlug[0] != '_' %}
    {% set historyPath = '/essays/published/' ~ currentSlug ~ '/history/' %}
    <p class="history-linkout"><a href="{{ historyPath | url }}">Browse full history →</a></p>
  {% endif %}
</section>

{% if status == "published" %}
  {% include "giscus.njk" %}
{% endif %}
