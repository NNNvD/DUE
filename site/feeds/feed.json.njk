---
permalink: feeds/feed.json
layout: null
eleventyExcludeFromCollections: true
---
{% set entries = collections.publishedEssays or [] %}
{% set feedUrl = 'feeds/feed.json' | url | absoluteUrl(site) %}
{% set siteUrl = '/' | url | absoluteUrl(site) %}
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ site.title | dump | safe }},
  "home_page_url": {{ siteUrl | dump | safe }},
  "feed_url": {{ feedUrl | dump | safe }},
  "items": [
    {% for entry in entries %}
      {% set entryTitle = entry.data.title or (entry.data.page and entry.data.page.title) or entry.fileSlug or 'Untitled essay' %}
      {% set canonicalUrl = (entry.data.canonical or entry.url | url) | absoluteUrl(site) %}
      {% set releaseNotes = entry.data.release_notes or [] %}
      {% set latestReleaseNote = releaseNotes | first or meta.extractDescription(entry.data) %}
      {% set entryVersion = entry.data.version | formatVersion(entry.data.initial_status) %}
      {
        "id": {{ canonicalUrl | dump | safe }},
        "url": {{ canonicalUrl | dump | safe }},
        "title": {{ entryTitle | dump | safe }},
        "date_published": {{ (entry.data.published_at or null) | dump | safe }},
        "version": {{ entryVersion | dump | safe }},
        "content_text": {{ latestReleaseNote | dump | safe }}
      }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
