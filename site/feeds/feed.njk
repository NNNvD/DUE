---
permalink: feeds/feed.xml
layout: null
eleventyExcludeFromCollections: true
---
{% set entries = collections.publishedEssays or [] %}
{% set feedUrl = 'feeds/feed.xml' | url | absoluteUrl(site) %}
{% set siteUrl = '/' | url | absoluteUrl(site) %}
{% set mostRecent = entries | first %}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:due="https://due.page/ns">
  <title>{{ site.title }}</title>
  <id>{{ siteUrl }}</id>
  <link href="{{ feedUrl }}" rel="self" />
  <link href="{{ siteUrl }}" rel="alternate" />
  <updated>
    {% if mostRecent and mostRecent.data.published_at %}
      {{ mostRecent.data.published_at | date('yyyy-LL-dd') }}
    {% else %}
      {{ page.date | date('yyyy-LL-dd') }}
    {% endif %}
  </updated>
  <author>
    <name>{{ site.title }}</name>
  </author>
  {% for entry in entries %}
    {% set entryTitle = entry.data.title or (entry.data.page and entry.data.page.title) or entry.fileSlug or 'Untitled essay' %}
    {% set canonicalUrl = meta.buildCanonicalUrl({ canonical: entry.data.canonical, canonical_url: entry.data.canonical_url, page: { url: entry.url }, site: site }) %}
    {% set releaseNotes = entry.data.release_notes or [] %}
    {% set latestReleaseNote = releaseNotes | first or meta.extractDescription(entry.data) %}
    {% set entryVersion = entry.data.version | formatVersion(entry.data.initial_status) %}
    <entry>
      <title>{{ entryTitle }}</title>
      <link href="{{ canonicalUrl }}" />
      <id>{{ canonicalUrl }}</id>
      {% if entry.data.published_at %}
        <published>{{ entry.data.published_at | date('yyyy-LL-dd') }}</published>
        <updated>{{ entry.data.published_at | date('yyyy-LL-dd') }}</updated>
      {% endif %}
      <due:version>{{ entryVersion }}</due:version>
      <summary type="text">{{ latestReleaseNote }}</summary>
    </entry>
  {% endfor %}
</feed>
