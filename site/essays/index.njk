---
layout: base.njk
title: "Essay library"
description: "Browse every DUE essay, whether it's live or still in draft, with color-coded length badges."
---
{% set published = collections.publishedEssays %}
{% set drafts = collections.draftEssays %}

<section class="page-header card">
  <p class="eyebrow">Library</p>
  <h2>Browse every essay</h2>
  <p class="lede">Scan the full catalogue to see what’s shipping next and what has already launched. Length badges use purple squares for Tiny essays (100–500 words), orange triangles for Minute essays (500–1000 words), and teal circles for Short essays (1000–1500 words).</p>
  <div class="stat-grid">
    <div class="stat">
      <div class="stat__number">{{ published.length }}</div>
      <div class="stat__label">Published</div>
    </div>
    <div class="stat">
      <div class="stat__number">{{ drafts.length }}</div>
      <div class="stat__label">Drafts</div>
    </div>
    <div class="stat">
      <div class="stat__number">{{ (published.length + drafts.length) }}</div>
      <div class="stat__label">Total essays</div>
    </div>
  </div>
</section>

<section class="essay-browser" data-search-interactive hidden data-base-url="{{ '/' | url }}">
  <div class="essay-browser__grid">
    <aside class="card filters filter-rail">
      <div class="filters__header">
        <div>
          <p class="eyebrow">Search & filter</p>
          <h3 class="card-title">Find an essay by topic, author, or length</h3>
          <p class="muted">Search titles, topics, keywords, authors, and coauthors. Then tick boxes like you're browsing a shop to refine by length, publication timing, authors, and keywords.</p>
        </div>
        <div class="filters__grid">
          <div class="filter-panel filter-panel--wide">
            <p class="filter-panel__label">Search</p>
            <p class="muted">Scan titles, topics, keywords, authors, and coauthors.</p>
            <label class="filter">
              <span class="visually-hidden">Search essays</span>
              <input type="search" name="q" placeholder="Try 'deadlines' or 'publishing'" data-filter-search>
            </label>
          </div>

          <div class="filter-panel">
            <p class="filter-panel__label">Length</p>
            <p class="muted">Pick any length band.</p>
            <div class="filter-options" data-filter-length-group>
              <label class="filter-option">
                <input type="checkbox" value="tiny">
                <span>Tiny (100–500 words)</span>
              </label>
              <label class="filter-option">
                <input type="checkbox" value="minute">
                <span>Minute (500–1000 words)</span>
              </label>
              <label class="filter-option">
                <input type="checkbox" value="short">
                <span>Short (1000–1500 words)</span>
              </label>
            </div>
          </div>

          <div class="filter-panel">
            <p class="filter-panel__label">Publication timing</p>
            <p class="muted">Choose when essays were published.</p>
            <div class="filter-options" data-filter-finished-group>
              <label class="filter-option">
                <input type="checkbox" value="finished-on-time">
                <span>Finished on time</span>
              </label>
              <label class="filter-option">
                <input type="checkbox" value="unfinished-on-time">
                <span>Unfinished on time</span>
              </label>
              <label class="filter-option">
                <input type="checkbox" value="draft">
                <span>Drafts</span>
              </label>
            </div>
          </div>

          <div class="filter-panel">
            <p class="filter-panel__label">Authors & coauthors</p>
            <p class="muted">Tick handles to include.</p>
            <div class="filter-options" data-filter-author-group>
              <p class="muted">Loading authors…</p>
            </div>
          </div>

          <div class="filter-panel">
            <p class="filter-panel__label">Keywords</p>
            <p class="muted">Stack multiple keyword tags.</p>
            <div class="filter-options" data-filter-keyword-group>
              <p class="muted">Loading keywords…</p>
            </div>
          </div>

          <div class="filter-panel">
            <p class="filter-panel__label">Sort</p>
            <p class="muted">Adjust the order.</p>
            <label class="filter">
              <span class="visually-hidden">Sort order</span>
              <select data-filter-sort>
                <option value="newest">Newest first</option>
                <option value="oldest">Oldest first</option>
              </select>
            </label>
          </div>
        </div>
      </div>
    </aside>

    <div class="essay-browser__results stack">
      <div class="section-heading">
        <p class="eyebrow">Interactive browser</p>
        <h3>Filter and search every essay</h3>
        <p class="muted">Results update instantly as you search. Drafts include a live countdown; published pieces carry their version and publication timing.</p>
      </div>
      <div class="card-list" data-search-results>
        <div class="card"><p>Loading the essay index…</p></div>
      </div>
    </div>
  </div>
</section>

<script type="application/json" data-essay-search>
  {{ essayIndex | dump | safe }}
</script>

<section class="stack" data-search-fallback>
  <div class="section-heading">
    <p class="eyebrow">Published</p>
    <h3>Latest releases</h3>
    <p class="muted">The newest essays first, with version numbers and release notes.</p>
  </div>
  {% if published.length %}
    <div class="card-list">
      {% for post in published %}
        <article class="card list-card">
          {% set length = post.data.word_range | wordRangeMeta %}
          <header class="list-card__header">
            <div class="list-card__title-row">
              {% if post.data.word_range %}
                <span class="length-icon length-icon--{{ length.icon }} length-icon--{{ length.palette }}" aria-hidden="true"></span>
              {% endif %}
              <h4 class="card-title {{ length.titleClass }}"><a href="{{ post.url | url }}">{{ post.data.title }}</a></h4>
            </div>
          </header>
          {% set timingLabel %}{% if post.data.initial_status == 'complete' %}Finished on time{% else %}Unfinished on time{% endif %}{% endset %}
          {% set timingClass %}{% if post.data.initial_status == 'complete' %}badge--tone-success{% else %}badge--tone-warn{% endif %}{% endset %}
          <div class="meta">
            <span class="badge badge--tone-info">v{{ post.data.version }}</span>
            <span class="badge {{ timingClass }}">{{ timingLabel }}</span>
            {% if post.data.published_at %}<span>Published {{ post.data.published_at | date("yyyy-LL-dd") }}</span>{% endif %}
          </div>
          <div class="meta meta--details">
            {% if post.data.word_count %}<span>{{ post.data.word_count }} words</span>{% endif %}
            {% if post.data.author %}<span>By <strong>{{ post.data.author | authorName }}</strong></span>{% endif %}
            {% if post.data.topic %}<span>Topic: <strong>{{ post.data.topic }}</strong></span>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="card"><p>No essays published yet.</p></div>
  {% endif %}
</section>

<section class="stack" data-search-fallback>
  <div class="section-heading">
    <p class="eyebrow">Drafts</p>
    <h3>Publishing soon</h3>
    <p class="muted">Drafts are ordered by their publish date so you can jump in where momentum is highest.</p>
  </div>
  {% if drafts.length %}
    <div class="card-list">
      {% for draft in drafts %}
        <article class="card list-card" data-deadline="{{ draft.data.deadline_at }}">
          {% set length = draft.data.word_range | wordRangeMeta %}
          <header class="list-card__header">
            <div class="list-card__title-row">
              {% if draft.data.word_range %}
                <span class="length-icon length-icon--{{ length.icon }} length-icon--{{ length.palette }}" aria-hidden="true"></span>
              {% endif %}
              <h4 class="card-title {{ length.titleClass }}">{{ draft.data.title }}</h4>
            </div>
          </header>
          <div class="meta">
            <span class="badge badge--tone-info">v{{ draft.data.version }}</span>
            <span class="badge badge--tone-info">Proposed</span>
            {% if draft.data.deadline_at %}
              <span class="badge deadline-badge" data-deadline-badge="{{ draft.data.deadline_at }}" data-deadline-label="{{ draft.data.deadline_at | date('yyyy-LL-dd') }}" title="Publishes on {{ draft.data.deadline_at | date('yyyy-LL-dd') }}"></span>
            {% else %}
              <span class="badge">Publication date pending</span>
            {% endif %}
          </div>
          <div class="meta meta--details">
            {% if draft.data.word_count %}<span>{{ draft.data.word_count }} words</span>{% endif %}
            {% if draft.data.author %}<span>By <strong>{{ draft.data.author | authorName }}</strong></span>{% endif %}
            {% if draft.data.topic %}<span>Topic: <strong>{{ draft.data.topic }}</strong></span>{% endif %}
          </div>
          {% if draft.data.deadline_at %}
            <p class="countdown" data-deadline="{{ draft.data.deadline_at }}"><span data-countdown>Tracking publication date…</span></p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="card"><p>No drafts in progress. New drafts will appear here once scheduled.</p></div>
  {% endif %}
</section>

<script type="module" src="{{ '/assets/search.js' | url }}"></script>
