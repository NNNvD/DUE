---
layout: base.njk
title: "DUE — Essays"
description: "See what is shipping now, browse recent essays, and jump into the next deadline."
---
{% set drafts = collections.draftEssays %}
{% set published = collections.publishedEssays %}
{% set proposals = drafts | whereStatus(['proposed', 'draft']) %}
{% set latest = published | first %}
{% set nextProposed = proposals | sortByDate('data.deadline_at') | first %}
{% set nextDeadline = nextProposed and nextProposed.data.deadline_at %}
{% set daysUntilNext = nextDeadline | daysUntil %}
{% set publishedCount = essayStats.published %}
{% set ideasCount = essayStats.drafts %}

<section class="hero card spotlight">
  <div class="hero__copy">
    <p class="eyebrow">Deadline for Unfinished Essays</p>
    <h2>Propose. Panic. Publish.</h2>
    <p class="lede">DUE is a collaborative platform for short-form essays written under pressure. Writers choose a keyword set, pick a word range—Tiny (250–500 words), Minute (500–1000), or Short (1000–1500)—and have 30 days to deliver. When the deadline hits, the essay goes live, finished or not.</p>
    <p class="muted">Purple squares mark Tiny essays, orange triangles Minute essays, and teal circles Short essays.</p>
    <div class="legend-badges">
      <span class="legend-badge legend-badge--square magenta">Tiny · 250–500 words</span>
      <span class="legend-badge legend-badge--triangle orange">Minute · 500–1000 words</span>
      <span class="legend-badge legend-badge--circle teal">Short · 1000–1500 words</span>
    </div>
  </div>
  <div class="hero__visual">
     <img class="hero__photo" src="{{ '/assets/uploads/front-hero.png' | url }}" alt="Colorful painting of a person writing at a desk">
    <div class="hero__stats">
      <div class="hero__stat">
        <span class="hero__stat-number">{{ publishedCount }}</span>
        <span class="hero__stat-label">Essays published</span>
      </div>
      <div class="hero__stat">
        <span class="hero__stat-number">{{ ideasCount }}</span>
        <span class="hero__stat-label">Ideas proposed</span>
      </div>
      <div class="hero__stat" {% if nextDeadline %}data-deadline="{{ nextDeadline }}"{% endif %}>
        <span class="hero__stat-number" data-countdown>
          {% if daysUntilNext is not null %}
            {{ daysUntilNext }}
          {% else %}
            —
          {% endif %}
        </span>
        <span class="hero__stat-label">
          {% if nextDeadline %}
            Days until next publication
          {% else %}
            Next publication date not scheduled
          {% endif %}
        </span>
      </div>
    </div>
  </div>
</section>

<section class="grid grid-two">
  <article class="card in-progress">
    <div class="section-heading">
      <p class="eyebrow">Now writing</p>
      <h3>In progress</h3>
      <p>These drafts are currently under development. Drafts only show titles and keywords. They can be read and commented on after publication.</p>
    </div>
    {% if drafts.length %}
      {% set active = drafts[0] %}
      <div class="stack">
        <div class="meta">
          {% if active.data.word_range %}<span class="badge {{ active.data.word_range | wordRangeTone }}">{{ active.data.word_range }} words</span>{% endif %}
          {% if active.data.started_at %}<span>Started {{ active.data.started_at | date("yyyy-LL-dd") }}</span>{% endif %}
          {% if active.data.deadline_at %}<span>Publishes on {{ active.data.deadline_at | date("yyyy-LL-dd") }}</span>{% endif %}
        </div>
        <h4 class="card-title">{{ active.data.title }}</h4>
        {% if active.data.browser_keywords and active.data.browser_keywords.length %}<p class="muted"><strong>Keywords:</strong> {{ active.data.browser_keywords | join(", ") }}</p>{% endif %}
        <p class="countdown" {% if active.data.deadline_at %}data-deadline="{{ active.data.deadline_at }}"{% endif %}><span data-countdown>{% if active.data.deadline_at %}Tracking publication date…{% else %}Deadline not yet scheduled.{% endif %}</span></p>
      </div>
      {% if drafts.length > 1 %}
        <div class="divider"></div>
        <div class="stack">
          <p class="eyebrow">Also drafting</p>
          <ul class="draft-list">
            {% for draft in drafts %}
              {% if not loop.first %}
              <li>
                <span class="draft-title">{{ draft.data.title }}</span>
                {% if draft.data.deadline_at %}<span class="muted"> — publishing on {{ draft.data.deadline_at | date("yyyy-LL-dd") }}</span>{% endif %}
              </li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    {% else %}
      <p>No drafts in progress. Check back soon for the next deadline.</p>
    {% endif %}
  </article>

  <article class="card">
    <div class="section-heading">
      <p class="eyebrow">Latest release</p>
      <h3>Most recently published</h3>
      <p>Read the latest release before the next round of edits.</p>
    </div>
    {% if latest %}
      {% set length = latest.data.word_range | wordRangeMeta %}
      <div class="stack">
        {% if latest.data.word_range %}
          <div class="length-chip length-chip--icon-only" aria-label="Length indicator: {{ length.label }}">
            <span class="length-icon length-icon--{{ length.icon }} length-icon--{{ length.palette }}" aria-hidden="true"></span>
            <span class="length-chip__text">{{ length.label }}</span>
          </div>
        {% endif %}
        <h4 class="card-title {{ length.titleClass }}"><a href="{{ latest.url | url }}">{{ latest.data.title }}</a></h4>
          {% set latestTimingLabel %}{% if latest.data.initial_status == 'complete' %}Finished on time{% else %}Unfinished on time{% endif %}{% endset %}
          {% set latestTimingClass %}{% if latest.data.initial_status == 'complete' %}badge--tone-success{% else %}badge--tone-warn{% endif %}{% endset %}
          <div class="meta">
            <span class="badge badge--tone-info">v{{ latest.data.version | formatVersion(latest.data.initial_status) }}</span>
            <span class="badge {{ latestTimingClass }}">{{ latestTimingLabel }}</span>
            {% if latest.data.published_at %}<span>Published {{ latest.data.published_at | date("yyyy-LL-dd") }}</span>{% endif %}
          </div>
        <div class="meta">
          {% if latest.data.word_count %}<span>{{ latest.data.word_count }} words</span>{% endif %}
          {% if latest.data.author %}<span>By <strong>{{ latest.data.author | authorName }}</strong></span>{% endif %}
          {% if latest.data.browser_keywords and latest.data.browser_keywords.length %}<span>Keywords: {{ latest.data.browser_keywords | join(", ") }}</span>{% endif %}
        </div>
      </div>
    {% else %}
      <p>No essays published yet.</p>
    {% endif %}
  </article>
</section>

<section class="card">
  <div class="section-heading">
    <p class="eyebrow">Explore</p>
    <h3>Keep reading and contributing</h3>
  </div>
  <div class="card-grid">
    <div class="card panel">
      <p class="eyebrow">Library</p>
      <h4 class="card-title">Browse essays</h4>
      <p class="muted">See everything, published or unpublished on time, and drafts in one place.</p>
      <a class="inline-link" href="{{ '/essays/' | url }}">Open the library →</a>
    </div>
    <div class="card panel">
      <p class="eyebrow">Deadlines</p>
      <h4 class="card-title">Draft schedule</h4>
      <p class="muted">View drafts ordered by set publication date to plan your reading. Drafts only show titles and keywords.</p>
      <a class="inline-link" href="{{ '/drafts/' | url }}">See the queue →</a>
    </div>
    <div class="card panel">
      <p class="eyebrow">Backstory</p>
      <h4 class="card-title">About DUE</h4>
      <p class="muted">Learn how deadlines, credits, and feedback shape this platform.</p>
      <a class="inline-link" href="{{ '/about/' | url }}">Read the story →</a>
    </div>
  </div>
</section>
