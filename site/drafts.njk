---
layout: base.njk
title: "Draft Schedule"
description: "All essays in draft mode ordered by publish date."
---
{% set drafts = collections.draftEssays %}

<section class="page-header card">
  <p class="eyebrow">Draft schedule</p>
  <h2>What is publishing next</h2>
  <p class="lede">Every draft is listed by its publish date so you can see where help is needed most. Join before the deadline hits.</p>
</section>

{% if drafts.length %}
  <div class="card-list">
    {% for draft in drafts %}
      <article class="card draft-card" data-deadline="{{ draft.data.deadline_at }}">
        <header class="list-card__header">
          <h3 class="card-title">{{ draft.data.title }}</h3>
          <div class="meta">
            {% if draft.data.deadline_at %}
              <span
                class="badge deadline-badge"
                data-deadline-badge="{{ draft.data.deadline_at }}"
                data-deadline-label="{{ draft.data.deadline_at | date('yyyy-LL-dd') }}"
                title="Publishes {{ draft.data.deadline_at | date('yyyy-LL-dd') }}"
              >{{ draft.data.deadline_at | date('yyyy-LL-dd') }}</span>
            {% else %}
              <span class="badge">Deadline pending</span>
            {% endif %}
            {% if draft.data.word_range %}<span class="badge {{ draft.data.word_range | wordRangeTone }}">{{ draft.data.word_range }} words</span>{% endif %}
            {% if draft.data.started_at %}<span>Started {{ draft.data.started_at | date("yyyy-LL-dd") }}</span>{% endif %}
          </div>
        </header>
        {% if draft.data.topic %}<p class="muted"><strong>Topic:</strong> {{ draft.data.topic }}</p>{% endif %}
        <p class="countdown">
          <span data-countdown>
            {% if draft.data.deadline_at %}
              Publishes at {{ draft.data.deadline_at | date('yyyy-LL-dd') }}
            {% else %}
              Deadline not yet scheduled.
            {% endif %}
          </span>
        </p>
      </article>
    {% endfor %}
  </div>
{% else %}
  <div class="card">
    <p>No drafts in progress. Start a new essay to begin writing.</p>
  </div>
{% endif %}
