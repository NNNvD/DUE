---
layout: base.njk
title: "Draft Schedule"
description: "All essays in draft mode ordered by publish date."
---
{% set drafts = collections.draftEssays %}

<section class="page-header card">
  <p class="eyebrow">Draft schedule</p>
  <h2>What’s publishing next</h2>
  <p class="lede">Every active draft is listed by its publish date so you can see where help is needed most—ideally before the deadline hits.</p>
</section>

{% if drafts.length %}
  <div class="card-list">
    {% for draft in drafts %}
      {% set length = draft.data.word_range | wordRangeMeta %}
      <article class="card draft-card" data-deadline="{{ draft.data.deadline_at }}">
        <header class="list-card__header">
          <div>
            <p class="eyebrow">Draft</p>
            <div class="stack">
              {% if draft.data.word_range %}
                <div class="length-chip length-chip--icon-only" aria-label="Length indicator: {{ length.label }}">
                  <span class="length-icon length-icon--{{ length.icon }} length-icon--{{ length.palette }}" aria-hidden="true"></span>
                  <span class="length-chip__text">{{ length.label }}</span>
                </div>
              {% endif %}
              <h3 class="card-title {{ length.titleClass }}">{{ draft.data.title }}</h3>
            </div>
            <div class="meta meta--draft">
              <span class="badge badge--tone-info">v{{ draft.data.version | formatVersion(draft.data.initial_status) }}</span>
              <span class="badge badge--tone-info">Proposed</span>
              {% if draft.data.deadline_at %}
                <span
                  class="badge deadline-badge"
                  data-deadline-badge="{{ draft.data.deadline_at }}"
                  data-deadline-label="{{ draft.data.deadline_at | date('yyyy-LL-dd') }}"
                  title="Publishes on {{ draft.data.deadline_at | date('yyyy-LL-dd') }}"
                ></span>
              {% else %}
                <span class="badge">Publication date pending</span>
              {% endif %}
            </div>
          </div>
          <div class="countdown" aria-live="polite" role="status">
            <p class="muted">Time to publish</p>
            <p class="countdown-value" data-countdown>
              {% if draft.data.deadline_at %}
                Tracking publication date…
              {% else %}
                Deadline not yet scheduled.
              {% endif %}
            </p>
          </div>
        </header>

        <dl class="draft-meta">
          {% if draft.data.started_at %}
            <div>
              <dt>Started</dt>
              <dd>{{ draft.data.started_at | date("yyyy-LL-dd") }}</dd>
            </div>
          {% endif %}
          {% if draft.data.deadline_at %}
            <div>
              <dt>Publication date</dt>
              <dd>{{ draft.data.deadline_at | date("yyyy-LL-dd") }}</dd>
            </div>
          {% endif %}
          {% if draft.data.word_count and draft.data.status != 'proposed' %}
            <div>
              <dt>Word count</dt>
              <dd>{{ draft.data.word_count }} words</dd>
            </div>
          {% endif %}
          <div>
            <dt>Author</dt>
            <dd>{{ draft.data.author | authorName }}</dd>
          </div>
          {% if draft.data.topic %}
            <div>
              <dt>Topic</dt>
            <dd>{{ draft.data.topic }}</dd>
            </div>
          {% endif %}
        </dl>
      </article>
    {% endfor %}
  </div>
{% else %}
  <div class="card">
    <p>No drafts in progress. Check back soon for the next round.</p>
  </div>
{% endif %}
