<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redirecting to Decap OAuth</title>
    <link rel="icon" href="/DUE/favicon.ico" />
    <style>
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.6;
        padding: 2rem;
        max-width: 40rem;
        margin: 0 auto;
      }
      .skip-link {
        position: absolute;
        top: -40px;
        left: 0;
        padding: 8px 12px;
        background: #000;
        color: #fff;
        text-decoration: none;
      }
      .skip-link:focus {
        top: 0;
      }
      .card {
        border: 1px solid #d0d7de;
        border-radius: 8px;
        padding: 1.5rem;
        background: #f8fafc;
      }
      code {
        background: #eef2f6;
        padding: 0.1rem 0.35rem;
        border-radius: 4px;
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <main id="main-content" class="card" role="main">
      <h1>Redirecting to the GitHub login…</h1>
      <p id="status">Sending you to the configured Decap OAuth backend.</p>
      <p>
        Seeing this screen is normal if the site was built without a
        <code>DECAP_OAUTH_BASE</code> value. That variable should point at your deployed
        OAuth provider&apos;s <code>/api/auth</code> endpoint (for example,
        <code>https://your-oauth-host.example.com/api/auth</code>).
      </p>
      <details id="manual-config" hidden>
        <summary>Set an OAuth host manually</summary>
        <p>
          If you need to test before the build has that value, enter the OAuth base
          URL from your deployed provider. It will be stored in your browser and used
          as a fallback until a build supplies <code>DECAP_OAUTH_BASE</code>.
        </p>
        <form id="oauth-form">
          <label for="oauth-base">OAuth base URL (must end in <code>/api/auth</code>)</label>
          <input id="oauth-base" name="oauth-base" type="url" autocomplete="off" required style="width: 100%; margin: 0.5rem 0" />
          <button type="submit">Save and continue</button>
        </form>
      </details>
    </main>
    <script>
      (function () {
        const status = document.getElementById("status");
        const details = document.getElementById("manual-config");
        const form = document.getElementById("oauth-form");
        const input = document.getElementById("oauth-base");

        const buildValue = "{{ decap.oauth_base | default('') }}".trim();
        const params = new URLSearchParams(window.location.search || "");
        const queryValue = (params.get("oauth_base") || "").trim();
        const storedValue = (window.localStorage && window.localStorage.getItem("decap_oauth_base")) || "";

        // Persist a manual override from the query string for future visits.
        if (queryValue) {
          try {
            localStorage.setItem("decap_oauth_base", queryValue);
          } catch (error) {
            console.warn("Unable to store oauth_base override", error);
          }
          params.delete("oauth_base");
        }

        const target = queryValue || buildValue || storedValue;

        if (!target) {
          status.textContent =
            "Missing DECAP_OAUTH_BASE. Set it to the deployed OAuth host (ending in /api/auth).";
          details.hidden = false;

          form.addEventListener("submit", (event) => {
            event.preventDefault();
            const manual = input.value.trim();
            if (!manual) return;
            try {
              localStorage.setItem("decap_oauth_base", manual);
            } catch (error) {
              console.warn("Unable to store manual OAuth base", error);
            }
            status.textContent = "Redirecting…";
            window.location.replace(manual);
          });
          return;
        }

        const remaining = params.toString();
        const redirectTo = `${target}${remaining ? `?${remaining}` : ""}`;
        status.textContent = "Redirecting…";
        window.location.replace(redirectTo);
      })();
    </script>
  </body>
</html>
