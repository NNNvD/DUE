\fs24 \cf0 scripts/autopublish.js
\f1\b0  (auto-move overdue drafts \uc0\u8594  published)\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 const fs = require("fs-extra");\
const path = require("path");\
const matter = require("gray-matter");\
const dayjs = require("dayjs");\
const glob = require("glob");\
\
const draftsDir = "site/essays/drafts";\
const pubDir = "site/essays/published";\
\
function publishFile(fp) \{\
  const raw = fs.readFileSync(fp, "utf8");\
  const doc = matter(raw);\
  const d = doc.data;\
\
  d.status = "published";\
  d.version = d.initial_status === "complete" ? 1.0 : 0.1;\
  d.published_at = dayjs().format("YYYY-MM-DD");\
  d.release_notes = Array.isArray(d.release_notes) ? d.release_notes : [];\
  d.release_notes.unshift(`Auto-published at deadline ($\{dayjs().toISOString()\}).`);\
\
  const out = matter.stringify(doc.content, d);\
  const dest = path.join(pubDir, path.basename(fp));\
  fs.ensureDirSync(pubDir);\
  fs.writeFileSync(dest, out, "utf8");\
  fs.removeSync(fp);\
  console.log(`Published: $\{path.basename(fp)\} \uc0\u8594  v$\{d.version\}`);\
\}\
\
glob.sync(`$\{draftsDir\}/**/*.md`).forEach(fp => \{\
  const raw = fs.readFileSync(fp, "utf8");\
  const doc = matter(raw);\
  const d = doc.data;\
  if (!d.deadline_at) return;\
  if (dayjs().isAfter(dayjs(d.deadline_at))) publishFile(fp);\
\});\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b\fs24 \cf0 scripts/checkWordRange.js
\f1\b0  (CI gate)\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 const fs = require("fs");\
const matter = require("gray-matter");\
const \{ unified \} = require("unified");\
const parse = require("remark-parse");\
const strip = require("strip-markdown");\
const path = require("path");\
\
function wordCount(md) \{\
  const text = String(unified().use(parse).use(strip).processSync(md));\
  return text.trim().split(/\\s+/).filter(Boolean).length;\
\}\
function bounds(range) \{\
  const [lo, hi] = (range || "250-500").split("-").map(Number);\
  const grace = Math.ceil(0.02 * hi);\
  return [lo, hi + grace];\
\}\
function scan(dir) \{\
  if (!fs.existsSync(dir)) return [];\
  return fs.readdirSync(dir).filter(f => f.endsWith(".md")).map(f => path.join(dir, f));\
\}\
\
const files = [ ...scan("site/essays/drafts"), ...scan("site/essays/published") ];\
let errors = [];\
for (const fp of files) \{\
  const raw = fs.readFileSync(fp, "utf8");\
  const doc = matter(raw);\
  const wc = wordCount(doc.content);\
  const [lo, hi] = bounds(doc.data.word_range);\
  if (wc < lo || wc > hi) errors.push(`$\{fp\}: $\{wc\} words (expected $\{lo\}\'96$\{hi\})`);\
\}\
if (errors.length) \{ console.error("Word range check failed:\\n" + errors.join("\\n")); process.exit(1); \}\
console.log("Word ranges OK");\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b\fs24 \cf0 scripts/bumpVersionAndCredit.js
\f1\b0  (version bump + credits + snapshot)\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 const fs = require("fs");\
const pathLib = require("path");\
const matter = require("gray-matter");\
\
const labels = (process.env.PR_LABELS ? JSON.parse(process.env.PR_LABELS) : []).map(l => l.name);\
const user = process.env.PR_USER || "contributor";\
const intent = labels.includes("major") ? "major" : (labels.includes("minor") ? "minor" : null);\
\
const changed = (process.env.CHANGED_FILES || "")\
  .split(/\\r?\\n/).map(s => s.trim()).filter(Boolean)\
  .filter(fp => fp.startsWith("site/essays/published/") && fp.endsWith(".md"));\
\
if (!intent || changed.length === 0) \{ console.log("No intent label or no changed published essays; exiting."); process.exit(0); \}\
\
function bump(v, isMajor) \{\
  v = String(v); if (!/^\\d+\\.\\d+$/.test(v)) v = "0.1";\
  let [maj, pat] = v.split(".").map(Number);\
  return isMajor ? `$\{maj + 1\}.0` : `$\{maj\}.$\{(pat || 0) + 1\}`;\
\}\
\
for (const fp of changed) \{\
  const raw = fs.readFileSync(fp, "utf8");\
  const doc = matter(raw); const d = doc.data;\
\
  const newVersion = bump(d.version, intent === "major");\
  const note = `Contribution by @$\{user\} ($\{intent\}).`;\
  d.version = newVersion;\
  d.release_notes = [note, ...(d.release_notes || [])];\
\
  if (intent === "major") d.coauthors = Array.from(new Set([...(d.coauthors || []), user]));\
  else d.acknowledgments = [...(d.acknowledgments || []), \{ user, note: "Minor contribution", since_version: newVersion \}];\
\
  fs.writeFileSync(fp, matter.stringify(doc.content, d), "utf8");\
\
  // snapshot\
  const slug = pathLib.basename(fp, ".md");\
  const snapDir = pathLib.join("site","essays","snapshots", slug);\
  fs.mkdirSync(snapDir, \{ recursive: true \});\
  const snapFront = Object.assign(\{\}, d, \{\
    layout: "snapshot.njk",\
    origin_slug: slug,\
    permalink: `/essays/published/$\{slug\}/v$\{newVersion\}/`\
  \});\
  const snapMd = matter.stringify(doc.content, snapFront);\
  const snapPath = pathLib.join(snapDir, `v$\{newVersion\}.md`);\
  fs.writeFileSync(snapPath, snapMd, "utf8");\
  console.log(`Updated $\{fp\} \uc0\u8594  version $\{newVersion\} (snapshot written)`);\
\}\
\pard\pardeftab720\partightenfactor0

