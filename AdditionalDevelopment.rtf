\f0\b\fs24 \cf0 .github/workflows/issue-to-draft.yml
\f1\b0  (creates a draft file from \'93Start a new essay\'94 issue)\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 name: Issue \uc0\u8594  Draft PR\
on:\
  issues:\
    types: [opened, edited, labeled]\
permissions:\
  contents: write\
  issues: read\
  pull-requests: write\
jobs:\
  create-draft:\
    if: contains(github.event.issue.labels.*.name, 'new-essay')\
    runs-on: ubuntu-latest\
    steps:\
      - uses: actions/checkout@v4\
      - uses: actions/setup-node@v4\
        with: \{ node-version: 20 \}\
      - run: npm i dayjs fs-extra\
      - name: Generate draft from issue\
        env:\
          ISSUE_TITLE: $\{\{ github.event.issue.title \}\}\
          ISSUE_BODY: $\{\{ github.event.issue.body \}\}\
          ISSUE_USER: $\{\{ github.event.issue.user.login \}\}\
        run: |\
          node - <<'NODE'\
          const fs = require('fs-extra');\
          const dayjs = require('dayjs');\
          const slugify = s => s.toLowerCase().normalize('NFKD').replace(/[^\\w\\s-]/g,'').trim().replace(/\\s+/g,'-').replace(/-+/g,'-');\
\
          const title = process.env.ISSUE_TITLE.replace(/^\\[Essay\\]\\s*/,'').trim() || 'Untitled';\
          const body = process.env.ISSUE_BODY || '';\
          const pick = (label) => \{ const rx = new RegExp(`$\{label\}\\\\s*:\\\\s*([^\\\\n]+)`, 'i'); const m = body.match(rx); return m ? m[1].trim() : null; \};\
\
          const topic = pick('Topic') || 'Untitled topic';\
          const wordRange = pick('Word range') || '500-1000';\
          const initialStatus = (pick('Initial status')||'unfinished').toLowerCase().includes('complete') ? 'complete' : 'unfinished';\
          const startedAt = pick('Started at') || dayjs().format('YYYY-MM-DD');\
          const deadlineAt = pick('Deadline at') || dayjs(startedAt).add(30,'day').format('YYYY-MM-DD');\
\
          const slug = slugify(title);\
          const path = `site/essays/drafts/$\{slug\}.md`;\
          const fm = `---\\n`+\
          `title: "$\{title\}"\\n`+\
          `topic: "$\{topic\}"\\n`+\
          `author: $\{process.env.ISSUE_USER\}\\n`+\
          `coauthors: []\\n`+\
          `acknowledgments: []\\n`+\
          `status: draft\\n`+\
          `started_at: $\{startedAt\}\\n`+\
          `deadline_at: $\{deadlineAt\}\\n`+\
          `initial_status: $\{initialStatus\}\\n`+\
          `version: 0.1\\n`+\
          `word_range: "$\{wordRange\}"\\n`+\
          `release_notes: []\\n`+\
          `---\\n\\nStart writing here\'85\\n`;\
\
          fs.ensureFileSync(path);\
          fs.writeFileSync(path, fm, 'utf8');\
          fs.writeFileSync('___draft_path.txt', path);\
          NODE\
      - name: Create branch, commit, push, PR\
        run: |\
          BRANCH="essay/$(date +%s)"\
          git checkout -b "$BRANCH"\
          git add -A\
          git -c user.name="github-actions[bot]" -c user.email="41898282+github-actions[bot]@users.noreply.github.com" commit -m "chore: init draft from issue"\
          git push -u origin "$BRANCH"\
      - uses: actions/github-script@v7\
        with:\
          script: |\
            const fs = require('fs');\
            const path = fs.readFileSync('___draft_path.txt','utf8').trim();\
            const title = `Init draft: $\{context.payload.issue.title.replace(/^\\[Essay\\]\\s*/,'')\}`;\
            const body = `Generated from issue #$\{context.payload.issue.number\}.\\n- File: \\`$\{path\}\\`\\n- Please fill content and adjust front matter if needed.`;\
            await github.rest.pulls.create(\{\
              owner: context.repo.owner, repo: context.repo.repo,\
              head: context.ref.split('/').pop(), base: 'main',\
              title, body, draft: false\
            \});\
